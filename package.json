{
  "name": "nexus-arcade-os",
  "version": "0.2.0",
  "private": true,
  "description": "A futuristic desktop operating system in the browser. Offline-first PWA.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && npm run build:lite",
    "build:web": "vite build",
    "build:lite": "vite build --config vite.lite.config.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check . && node scripts/check-i18n.js",
    "format": "prettier --write .",
    "typecheck": "tsc -p jsconfig.json",
    "icons": "node scripts/build-icons.js",
    "test:live": "node scripts/test-live.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
